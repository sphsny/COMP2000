
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/navigation_home">

<fragment
        android:id="@+id/navigation_home"
        android:name="com.example.comp2000.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_menu"
        android:name="com.example.comp2000.ui.menu.MenuFragment"
        android:label="Menu"
        tools:layout="@layout/fragment_menu" />

    <fragment
        android:id="@+id/navigation_booking"
        android:name="com.example.comp2000.ui.booking.BookingRouterFragment"
        android:label="Booking" />

    <fragment
        android:id="@+id/navigation_client_booking"
        android:name="com.example.comp2000.ui.booking.ClientBookingFragment"
        android:label="Client Booking" />

    <fragment
        android:id="@+id/navigation_staff_booking"
        android:name="com.example.comp2000.ui.booking.StaffBookingFragment"
        android:label="Staff Booking" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.example.comp2000.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.comp2000.ProfileFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_profile" />
</navigation>
