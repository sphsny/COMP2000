<resources>
    <!-- Header, use as: <TextView style="@style/PrimaryHeader" android:text="Welcome!" /> -->
    <style name="PrimaryHeader">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">16</item>
    </style>

    <!-- Mini Header, use as: <TextView style="@style/SecondaryHeader" android:text="Welcome!" /> -->
    <style name="SecondaryHeader">
        <item name="android:background">@color/navy</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Button, use as: <Button style="@style/PrimaryButton" android:text="Click Me!" /> -->
    <style name="PrimaryButton">
        <item name="android:backgroundTint">@color/blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Card, for menu and bookings. Use as: style="@style/Card" -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/light_rose</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Form, for the reservation making forms. Use as: style="@style/Form" -->
    <style name="Form">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
    </style>

    <!-- Menu Item Photo. Use as: style="@style/MenuItemPhoto" -->
    <style name="MenuItemPhoto">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@color/white</item>
    </style>

    <!-- Card that holds details about a menu item. Use as: style="@style/FoodDetailsCard" -->
    <style name="FoodDetailsBox">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Food Item name. Use as: style="@style/FoodItemName" -->
    <style name="FoodItemName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Food Item Details. Use as: style="@style/FoodItemDetails" -->
    <style name="FoodItemDetails">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/light_grey</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginBottom">6sp</item>
    </style>

    <!-- Food Item Price. Use as: style="@style/FoodItemPrice" -->
    <style name="FoodItemPrice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Icons from ImageViews. Use as: style="@style/Icon" -->
    <style name="Icon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <!-- Text that describes a setting. Use as: style="@style/SettingsText" -->
    <style name="SettingsText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">8</item>
        <item name="android:textSize">20dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:padding">10dp</item>
    </style>
</resources>