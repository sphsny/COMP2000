<resources>
    <!-- Header, use as: <TextView style="@style/PrimaryHeader" android:text="Welcome!" /> -->
    <style name="PrimaryHeader">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Mini Header, use as: <TextView style="@style/SecondaryHeader" android:text="Welcome!" /> -->
    <style name="SecondaryHeader">
        <item name="android:backgroundTint">@color/navy</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:cornerRadius">8dp</item>
    </style>

    <!-- Button, use as: <Button style="@style/PrimaryButton" android:text="Click Me!" /> -->
    <style name="PrimaryButton">
        <item name="android:backgroundTint">@color/blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Card, for menu and bookings. Use as: <style="@style/Card" /> -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/light_rose</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Edit button, for customer to edit their bookings and staff to edit menu items. Use as: <?? style="@style/EditButton" /> -->

    <!-- Delete button, for customer to delete their booking, and staff to delete menu items. Use as: <?? style="@style/DeleteButton" /> -->

</resources>