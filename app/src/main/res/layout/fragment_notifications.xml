<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Log Screen Header -->
    <TextView style="@style/PrimaryHeader"
        android:id="@+id/log_screen_header"
        android:text="Notifications"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Notification Log Header -->
    <TextView style="@style/SecondaryHeader"
        android:id="@+id/notification_log"
        android:text="Notification Log"
        app:layout_constraintTop_toBottomOf="@id/log_screen_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Notification Box -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/notification_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:layout_marginHorizontal="10dp"
        android:background="@color/light_blue"
        app:layout_constraintTop_toBottomOf="@id/notification_log"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Notification text -->
        <TextView style="@style/SettingsText"
            android:id="@+id/notification_text"
            android:text="Your booking for the 03/11/2025 is confirmed!"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/date"
            app:layout_constrainedWidth="true"/>

        <!-- Date -->
        <TextView style="@style/SettingsText"
            android:id="@+id/date"
            android:text="31/10/25"
            android:textSize="16sp"
            android:textColor="@color/blue"
            app:layout_constraintTop_toTopOf="@id/notification_text"
            app:layout_constraintBottom_toBottomOf="@id/notification_text"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
