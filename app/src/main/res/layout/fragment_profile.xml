<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Profile Screen Header -->
        <TextView style="@style/PrimaryHeader"
            android:id="@+id/settings_screen_header"
            android:text="Profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Profile Settings Header -->
        <TextView style="@style/SecondaryHeader"
            android:id="@+id/settings_profile_header"
            android:text="Profile Data"
            app:layout_constraintTop_toBottomOf="@id/settings_screen_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Profile Settings Box -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profile_settings_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/settings_profile_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            android:paddingHorizontal="10dp"
            android:layout_marginTop="8dp"
            app:layout_constrainedWidth="true">

            <TextView
                android:id="@+id/username"
                style="@style/SettingsText"
                android:text="Username:"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/firstname"
                style="@style/SettingsText"
                android:text="Firstname:"
                app:layout_constraintTop_toBottomOf="@id/username"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/lastname"
                style="@style/SettingsText"
                android:text="Lastname:"
                app:layout_constraintTop_toBottomOf="@id/firstname"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/email"
                style="@style/SettingsText"
                android:text="Email:"
                app:layout_constraintTop_toBottomOf="@id/lastname"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/contact"
                style="@style/SettingsText"
                android:text="Contact:"
                app:layout_constraintTop_toBottomOf="@id/email"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Notification Settings Header -->
        <TextView style="@style/SecondaryHeader"
            android:id="@+id/settings_notifications_header"
            android:text="Notification Settings"
            app:layout_constraintTop_toBottomOf="@id/profile_settings_box"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <!-- Notification Settings Box -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/notification_setting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/settings_notifications_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/notification_setting_text1"
                style="@style/SettingsText"
                android:text="Receive notification upon booking update"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/notification_switch1"
                app:layout_constraintBottom_toTopOf="@id/notification_setting_text2" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/notification_switch1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@id/notification_setting_text1"
                app:layout_constraintBottom_toBottomOf="@id/notification_setting_text1"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/notification_setting_text2"
                style="@style/SettingsText"
                android:text="Receive notification when booking is cancelled"
                app:layout_constraintTop_toBottomOf="@id/notification_setting_text1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/notification_switch2"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/notification_switch2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@id/notification_setting_text2"
                app:layout_constraintBottom_toBottomOf="@id/notification_setting_text2"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/log_out"
            style="@style/PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:text="Log Out"
            app:layout_constraintTop_toBottomOf="@id/notification_setting_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

<!-- switch: https://developer.android.com/reference/com/google/android/material/switchmaterial/SwitchMaterial -->