<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/light_blue"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/del_confirm_header"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Cancellation"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/del_confirm_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Do you want to cancel this reservation?"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:paddingBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button style="@style/PrimaryButton"
            android:id="@+id/deletion_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:backgroundTint="#ED2939"/>

        <Button style="@style/PrimaryButton"
            android:id="@+id/deletion_submit_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:layout_marginStart="12dp" />
    </LinearLayout>
</LinearLayout>
