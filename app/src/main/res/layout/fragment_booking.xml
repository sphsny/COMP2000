<?xml version="1.0" encoding="utf-8"?>
<!-- scroll view as parent to make content scrollable -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- ConstraintLayout as direct child to make adaptable -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/booking_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <!-- Reservations Header -->
        <TextView style="@style/PrimaryHeader"
            android:id="@+id/reservations_header"
            android:text="Reservations"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Book a Table Header -->
        <TextView style="@style/SecondaryHeader"
            android:id="@+id/book_table_header"
            android:text="Book a table"
            app:layout_constraintTop_toBottomOf="@id/reservations_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Date -->
        <EditText
            android:id="@+id/date"
            style="@style/Form"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:hint="Date"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            app:layout_constraintTop_toBottomOf="@id/book_table_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/people"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1" />

        <!-- People -->
        <AutoCompleteTextView
            android:id="@+id/people"
            style="@style/Form"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:hint="People"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            app:layout_constraintTop_toTopOf="@id/date"
            app:layout_constraintStart_toEndOf="@id/date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1" />

        <!-- Time -->
        <AutoCompleteTextView
            android:id="@+id/time"
            style="@style/Form"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:hint="Time"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            app:layout_constraintTop_toBottomOf="@id/date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/submit_button"
            app:layout_constraintHorizontal_weight="1" />

        <!-- Submit Button -->
        <Button style="@style/PrimaryButton"
            android:id="@+id/submit_button"
            android:text="Submit"
            android:layout_height="56dp"
            android:layout_width="0dp"
            app:layout_constraintTop_toTopOf="@id/time"
            app:layout_constraintBottom_toBottomOf="@id/time"
            app:layout_constraintStart_toEndOf="@id/time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"/>

        <!-- Upcoming Reservations -->
        <TextView style="@style/SecondaryHeader"
            android:id="@+id/header_upcoming"
            android:text="Upcoming reservations"
            app:layout_constraintTop_toBottomOf="@id/time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- RecyclerView for reservation cards, card design in item_booking.xml -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reservation_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/header_upcoming"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>