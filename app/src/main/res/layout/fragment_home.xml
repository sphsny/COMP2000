<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="40dp">

        <!-- Welcome text -->
        <TextView style="@style/PrimaryHeader"
            android:id="@+id/welcome_header"
            android:text="Welcome to Our Restaurant!"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Restaurant Information text -->
        <TextView
            android:id="@+id/info_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Information about the Restaurant"
            android:textSize="18sp"
            android:textColor="@color/blue"
            android:gravity="center"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/welcome_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Image placeholder -->
        <ImageView
            android:id="@+id/restaurant_image"
            android:layout_width="280dp"
            android:layout_height="180dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Restaurant image"
            android:background="@color/light_rose"
            app:layout_constraintTop_toBottomOf="@id/info_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Container for Buttons -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/button_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/restaurant_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Browse Menu Button -->
            <Button style="@style/PrimaryButton"
                android:id="@+id/menu_button"
                android:layout_width="220dp"
                android:layout_height="70dp"
                android:text="Browse Menu"
                android:textSize="18sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Book Table Button -->
            <Button style="@style/PrimaryButton"
                android:id="@+id/book_table_button"
                android:layout_width="220dp"
                android:layout_height="70dp"
                android:text="Book a Table"
                android:textSize="18sp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/menu_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
